#!/bin/sh
set -e
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq curl gnupg ca-certificates apt-transport-https
install -d -m 0755 /etc/apt/keyrings /etc/apt/trusted.gpg.d
curl -fsSL https://repo.librewolf.net/keyring.gpg -o /etc/apt/keyrings/librewolf.gpg
cp /etc/apt/keyrings/librewolf.gpg /etc/apt/trusted.gpg.d/librewolf.gpg
cat << 'REPO' > /etc/apt/sources.list.d/librewolf.list
deb [signed-by=/etc/apt/keyrings/librewolf.gpg] https://repo.librewolf.net librewolf main
REPO
apt-get update
apt-get install -y librewolf
